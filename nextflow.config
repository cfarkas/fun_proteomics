manifest {
    name = 'pasef-proteomics'
    description = 'Native Bruker DDA-PASEF with FragPipe and DIA-PASEF with DIA-NN'
    version = '0.5.0'
    nextflowVersion = '>=26.04.2'
    mainScript = 'main.nf'
}
// CLI -work-dir overrides this location. Keep it for resume.
params.continue = false
params.config = null
params.config_file = null
params.dia_config = null
params.outdir = null
params.runtime_dir = System.getenv('PROTEOMICS_RUNTIME_DIR') ?: "${projectDir}/.runtime"
// --continue selects this study's latest real session, not a setup/preview run.
// Native -resume and -work-dir retain precedence in Nextflow's ConfigBuilder.
resume = ({ ->
    if (params.dia_config != null || params.continue.toString() != 'true') return null
    def python = new File("${params.runtime_dir}/env/bin/python")
    def command = [python.isFile() ? python.toString() : 'python3', "${projectDir}/scripts/continue_run.py".toString(),
                   '--project', projectDir.toString(), '--launch', launchDir.toString(),
                   '--config', (params.dia_config ?: params.config ?: params.config_file ?: "${projectDir}/config.local.json").toString()]
    if (params.outdir) command += ['--outdir', params.outdir.toString()]
    def process = new ProcessBuilder(command).start()
    def output = process.inputStream.text
    if (process.waitFor() != 0) throw new IllegalArgumentException('Could not inspect continuation history: '+process.errorStream.text)
    return new groovy.json.JsonSlurper().parseText(output).session
}).call()
workDir = ({ ->
    if (params.dia_config != null || params.continue.toString() != 'true') return 'work'
    def python = new File("${params.runtime_dir}/env/bin/python")
    def command = [python.isFile() ? python.toString() : 'python3', "${projectDir}/scripts/continue_run.py".toString(),
                   '--project', projectDir.toString(), '--launch', launchDir.toString(),
                   '--config', (params.dia_config ?: params.config ?: params.config_file ?: "${projectDir}/config.local.json").toString()]
    if (params.outdir) command += ['--outdir', params.outdir.toString()]
    def process = new ProcessBuilder(command).start()
    def output = process.inputStream.text
    if (process.waitFor() != 0) throw new IllegalArgumentException('Could not inspect continuation history: '+process.errorStream.text)
    return new groovy.json.JsonSlurper().parseText(output).workdir ?: 'work'
}).call()
env.PATH = "${params.runtime_dir}/env/bin:${System.getenv('PATH')}"
env.JAVA_HOME = "${params.runtime_dir}/env"
env.PYTHONUNBUFFERED = '1'

process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    // The launch-side monitor streams logs live without altering task cache keys.
    debug = false
}
executor {
    queueSize = 1
    cpus = Runtime.runtime.availableProcessors()
    memory = "${(java.lang.management.ManagementFactory.operatingSystemMXBean.totalPhysicalMemorySize / (1024L * 1024L * 1024L)).longValue()} GB"
}
profiles {
    test {
        process {
            withName: FRAGPIPE {
                cpus = 1
                memory = '1 GB'
            }
        }
    }
}

// Study output for default trace/report locations; UI supplies explicit paths.
trace.overwrite = true
trace.enabled = true
trace.file = "${({ ->
    def studyPath = new File((params.dia_config ?: params.config ?: params.config_file ?: "${projectDir}/config.local.json").toString())
    if (!studyPath.isAbsolute()) studyPath = new File(launchDir.toString(), studyPath.toString())
    def studyOutput = !params.outdir && studyPath.isFile() ? new groovy.json.JsonSlurper().parse(studyPath).outdir : null
    def resultPath = new File((params.outdir ?: studyOutput ?: launchDir).toString())
    if (!resultPath.isAbsolute()) resultPath = new File(params.outdir ? launchDir.toString() : studyPath.parent, resultPath.toString())
    return new File(resultPath, 'logs').absolutePath
}).call()}/nextflow_${new Date().format('yyyyMMdd_HHmmss')}_trace.tsv"
report.enabled = true
report.overwrite = true
report.file = "${({ ->
    def studyPath = new File((params.dia_config ?: params.config ?: params.config_file ?: "${projectDir}/config.local.json").toString())
    if (!studyPath.isAbsolute()) studyPath = new File(launchDir.toString(), studyPath.toString())
    def studyOutput = !params.outdir && studyPath.isFile() ? new groovy.json.JsonSlurper().parse(studyPath).outdir : null
    def resultPath = new File((params.outdir ?: studyOutput ?: launchDir).toString())
    if (!resultPath.isAbsolute()) resultPath = new File(params.outdir ? launchDir.toString() : studyPath.parent, resultPath.toString())
    return new File(resultPath, 'logs').absolutePath
}).call()}/nextflow_${new Date().format('yyyyMMdd_HHmmss')}_report.html"
timeline.enabled = true
timeline.overwrite = true
timeline.file = "${({ ->
    def studyPath = new File((params.dia_config ?: params.config ?: params.config_file ?: "${projectDir}/config.local.json").toString())
    if (!studyPath.isAbsolute()) studyPath = new File(launchDir.toString(), studyPath.toString())
    def studyOutput = !params.outdir && studyPath.isFile() ? new groovy.json.JsonSlurper().parse(studyPath).outdir : null
    def resultPath = new File((params.outdir ?: studyOutput ?: launchDir).toString())
    if (!resultPath.isAbsolute()) resultPath = new File(params.outdir ? launchDir.toString() : studyPath.parent, resultPath.toString())
    return new File(resultPath, 'logs').absolutePath
}).call()}/nextflow_${new Date().format('yyyyMMdd_HHmmss')}_timeline.html"
